# 任务一（评审目标一：真人体 vs 伪造影像）推理配置。
# 用法：把需要的行拷进启动脚本 / 容器环境变量，或 `set` 后再启动推理服务。

# ---- 权重 ---------------------------------------------------------------
# 默认使用 task1/weights/*.pt（当前 = 两个随机种子的 best.pt，取均值集成）。
# 需要指定时用 os.pathsep 分隔（Windows 用 ';'，Linux 用 ':'）。
# TASK1_WEIGHTS=E:\111new\Comp\Glioma_recognition-main\task1\weights\authenticity_seed0.pt

# ---- 计算 ---------------------------------------------------------------
# auto | cpu | cuda | cuda:0
TASK1_DEVICE=auto
# 每次前向的切片数；显存不足时降到 8 或 4。
TASK1_BATCH_SLICES=32

# ---- 与训练保持一致的几何参数（留空/0 表示沿用权重里记录的值） ----------
# TASK1_SLICES_PER_CASE=16
# TASK1_IMAGE_SIZE=224
TASK1_MIN_STD=0.05

# ---- 聚合 ---------------------------------------------------------------
# 一个检查内多条序列：max（只要一条可疑就标记，默认）| mean
TASK1_SERIES_AGGREGATION=max
# 多权重之间：mean（默认）| max
TASK1_MODEL_AGGREGATION=mean

# ---- 健壮性 -------------------------------------------------------------
# 所有序列都读不出来时输出的兜底概率（排序指标要求每例都有连续值）。
TASK1_FALLBACK_PROB=0.5
# 1 = 权重缺失/加载失败直接启动失败（自检用）；0 = 记录错误并降级启动。
TASK1_STRICT=0

# ---- 训练（服务器上执行，不需要改管线代码） -----------------------------
# 赛方训练数据根目录（含 annotation/）
TASK1_DATA_ROOT=/2026aicompetition/datasets/training
# 训练产物目录（best.pt / last.pt / manifest.jsonl / summary.json）
TASK1_RUN_DIR=/2026aicompetition/workspace/task1_runs
# 比赛日志目录（training.jsonl）；默认 $COMPETITION_WORKSPACE/logs
# TASK1_LOG_DIR=/2026aicompetition/workspace/logs

# ---- 与比赛推理服务对接（管线侧，仅设置环境变量） -----------------------
# task1 位于管线仓库的上一层，管线代码无需修改，但要让它能 import 到 task1。
# 在启动推理服务的 shell 里把 task1 的上一层加入 PYTHONPATH（例：/2026aicompetition/workspace/dcs）。
PYTHONPATH=/2026aicompetition/workspace/dcs
COMPETITION_PIPELINE_FACTORY=task1.pipeline_factory:build_pipeline

# ---- 任务二：拼接影像检测 ------------------------------------------------
TASK2_STITCHED=1
# 判定阈值：先把下面两个自检命令跑一遍，再填 --out-dir 里标定出的 threshold
TASK2_STITCHED_THRESHOLD=0.16
# curvature（当前层 vs 上下层均值）| adjacent | local（相对自身层间差）
TASK2_STITCHED_METRIC=curvature
# 层分数汇总：max | p99 | mean
TASK2_STITCHED_STAT=max
# 丢弃层方向两端各该比例的层（FOV 边缘本身层间变化大）
TASK2_STITCHED_BAND=0.1
TASK2_STITCHED_SCALE=8.0
TASK2_STITCHED_GATE=1

# ---- 任务二：重复影像检测 ------------------------------------------------
TASK2_DUPLICATE=1
# 1 = 先扫全库抽中间层建索引（思路要求）；0 = 只和已见过的检查增量比对
TASK2_DUPLICATE_SCAN=1
# 全库扫描条数上限（0 = 不限），大测试集可用来限时
TASK2_DUPLICATE_SCAN_MAX_VOLUMES=0
TASK2_DUPLICATE_GATE=1
TASK2_MAX_PAIRS=200

# ---- 任务二：下游闸门 ----------------------------------------------------
# 命中拼接/重复后不再执行的任务（需要连目标一一起跳过时加上 goal1）
TASK2_GATED_FIELDS=goal3,goal4,goal5
